# Copy to .env and fill in. Without a key the agent uses its offline rules.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# NBA_AGENT_OFFLINE=1

# Read-only X recent search: Shams + both teams' official/PR and reporter accounts.
# Obtain API access at https://developer.x.com/ and configure locally; never commit keys.
X_BEARER_TOKEN=

# Independent in-play filtered stream + recent-search recovery.
# Prefer a separate X App/project; no fallback to the pregame X_BEARER_TOKEN.
INPLAY_X_BEARER_TOKEN=
