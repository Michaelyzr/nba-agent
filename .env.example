# Copy to .env and fill in. Without a key the agent uses its offline rules.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# NBA_AGENT_OFFLINE=1

# Read-only X recent search: Shams + both teams' official/PR and reporter accounts.
# Obtain API access at https://developer.x.com/ and configure locally; never commit keys.
X_BEARER_TOKEN=

# Independent in-play filtered stream + recent-search recovery.
# Prefer a separate X App/project; no fallback to the pregame X_BEARER_TOKEN.
INPLAY_X_BEARER_TOKEN=

# Pregame alerts: local alerts are always recorded; external delivery requires
# live mode, --notify, ALERT_ENABLED=true and a webhook URL.
ALERT_ENABLED=false
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
ALERT_MIN_SEVERITY=medium
ALERT_PROBABILITY_SHIFT_PP=3.0
ALERT_HIGH_PROBABILITY_SHIFT_PP=5.0
ALERT_MARKET_MOVE_PP=3.0
ALERT_HIGH_MARKET_MOVE_PP=5.0
ALERT_MARKET_WINDOW_MINUTES=5.0
ALERT_QUOTE_MAX_AGE_SECONDS=90
ALERT_WEBHOOK_TIMEOUT_SECONDS=3
ALERT_WEBHOOK_RETRIES=2
# Courtside notifications are enabled explicitly with `python -m agents.dashboard_server --notify`.
# Optional per-event cooldown overrides, in seconds.
# ALERT_COOLDOWN_INJURY_STATUS_CHANGE=600
# ALERT_COOLDOWN_PROBABILITY_SHIFT=300
# ALERT_COOLDOWN_MARKET_MOVE=300
