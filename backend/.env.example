APP_ENV=development
APP_DEBUG=false
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nba_agent
FRONTEND_ORIGIN=http://localhost:3000
NBA_SEASON=2026-27
# Optional: the game Elo engine does not require an API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
MIN_TEAM_HISTORY=10
SIGNAL_MIN_EDGE=0.05
MARKET_MAX_AGE_SECONDS=900
MARKET_MIN_LIQUIDITY=1000
MARKET_MAX_SPREAD=0.05
PAPER_COST_BUFFER=0.01
PAPER_MAX_STAKE=100
PAPER_MAX_EXPOSURE=500
# Recent ordinary news; unresolved long-term events have no fixed age cutoff.
NEWS_RECENT_HOURS=168
# Older unresolved reports are shown as requiring review, not current certainty.
NEWS_REVIEW_AFTER_HOURS=168
# Sources are polled only while the backend is running. No PostgreSQL writes.
NEWS_AUTO_COLLECT=true
NEWS_POLL_SECONDS=900
# Paid extraction is opt-in; every extracted news event requires review.
NEWS_AUTO_EXTRACT=false
NEWS_EXTRACT_LIMIT=3
INJURY_STATUS_MAX_HOURS=24
INJURY_TRAINING_MIN_GAMES=200
